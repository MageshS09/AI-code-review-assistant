# Backend (app.py) - all optional
# Set to 1 only for local development; enables the Flask debugger.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
PORT=5000
# Comma-separated list of allowed browser origins. Defaults to "*".
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite) - optional
# Base URL of the API when it is not served from the same origin.
# Leave empty to use the Vite dev proxy / same-origin /api routes.
VITE_API_BASE_URL=
